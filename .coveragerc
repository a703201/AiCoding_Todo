[run]
source = .
omit =
    */tests/*
    */test/*
    */migrations/*
    */__pycache__/*
    */site-packages/*
    *.pyc

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod

# 覆盖率目标
fail_under = 80

show_missing = True
skip_covered = False

[html]
directory = htmlcov
